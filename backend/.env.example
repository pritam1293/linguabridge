# LinguaBridge backend configuration.
# Copy to .env and adjust. Every key is optional.

# "ollama" (real) or "mock" (deterministic, no model needed).
LB_LLM_MODE=ollama

# Ollama is expected on the default local port.
LB_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Any multilingual model you have pulled. qwen2.5:7b is a good
# quality/size trade-off for translation; llama3.1:8b also works well.
LB_OLLAMA_MODEL=qwen2.5:7b

# Cold starts on CPU can take a while; 90s avoids spurious timeouts.
LB_OLLAMA_TIMEOUT_S=90
LB_OLLAMA_NUM_CTX=4096
LB_OLLAMA_KEEP_ALIVE=30m
LB_TEMPERATURE=0.2

# Bounds.
LB_MAX_MESSAGE_CHARS=4000
LB_MAX_HISTORY_MESSAGES=6
LB_MAX_HISTORY_CHARS=3000
LB_RATE_LIMIT_PER_MINUTE=30
LB_CACHE_TTL_S=3600

# Bind to loopback only. Do not expose this service to a network.
LB_HOST=127.0.0.1
LB_PORT=8787
LB_LOG_LEVEL=INFO
